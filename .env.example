# ── Stripe ───────────────────────────────────────────────────────────────
# Secret key (sk_test_... / sk_live_...). Server-side only.
STRIPE_SECRET_KEY=
# The signing secret for your Stripe webhook endpoint, configured in the
# Stripe Dashboard → Webhooks (whsec_...). Required by /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# One-time pay-per-video price IDs. Create one Product + Price per tier.
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_AGENT=
# Public base URL for success/cancel redirects and webhook URLs.
# In local dev this can be http://localhost:3000 (or your tunnel).
NEXT_PUBLIC_BASE_URL=

# ── Fal.ai ───────────────────────────────────────────────────────────────
# Auto-generated API key from the Fal dashboard. Enables generation.
FAL_KEY=
# Optional model override (defaults to fal-ai/wan/v2.2-a14b/text-to-video).
FAL_MODEL=
# Shared secret for the Fal → Atom completion webhook (sent as a Bearer token).
FAL_WEBHOOK_SECRET=

# ── Neon Postgres ─────────────────────────────────────────────────────────
# Connection string to your Neon project (or any Postgres). Required for order
# + video persistence (db/schema.sql, run via `npm run db:migrate`).
# Format: postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL=
# Fallback alias (some hosts/Turso-style tables use POSTGRES_URL).
# POSTGRES_URL=

# ── Worker (docs/process-job.js, optional standalone renderer) ─────────
# Overrides for where jobs/deliverables live. Defaults to /tmp/atom-jobs and
# ~/Desktop/Atom-Deliverables when unset.
# ATOM_JOBS_DIR=
# ATOM_DELIVERABLES_DIR=
